<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background_gradient"
    tools:context=".PcView" >

    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="70dp"
        android:layout_height="match_parent"
        android:background="@color/black_purple"
        android:elevation="4dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="16dp"
            android:rotation="-90"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_above="@id/appTitle">

            <ImageButton
                android:id="@+id/grid_toggle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/help"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/grid_toggle" />

            <ImageButton
                android:id="@+id/controllerButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/addpcbuttonrounded"
                android:backgroundTint="@color/purple_accent"
                android:src="@drawable/ic_gamepad"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Controller Mapping" />

            <ImageButton
                android:id="@+id/manuallyAddPc"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="@string/add_pc" />

            <ImageButton
                android:id="@+id/helpButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_help"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="@string/help" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="@string/category_basic_settings" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="fill_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/headerLayout"
        android:layout_toRightOf="@id/headerLayout"
        android:layout_above="@+id/bottom_nav_bar"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/purple_accent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/pcs_loading"
                android:layout_toEndOf="@+id/pcs_loading"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                android:layout_centerVertical="true"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:gravity="center"
                android:text="@string/searching_pc"
                android:textColor="#FFFFFF"/>
        </RelativeLayout>

    </RelativeLayout>

    <include layout="@layout/bottom_nav_layout" />

</RelativeLayout>
