<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="70dp"
    android:transitionName="bottom_nav_bar"
    android:layout_alignParentBottom="true"
    android:background="@drawable/navigation"
    android:orientation="horizontal"
    android:gravity="center"
    android:elevation="8dp">

    <!-- Computers Tab -->
    <LinearLayout
        android:id="@+id/nav_computers"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/nav_computers_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_computer" />

        <TextView
            android:id="@+id/nav_computers_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Computers"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Settings Tab -->
    <LinearLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/nav_settings_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_settings" />

        <TextView
            android:id="@+id/nav_settings_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
