<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">
    <Button
        android:id="@+id/setKeyboardButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:text="Set Keyboard Key"
        android:textSize="12sp"
        android:backgroundTint="@color/deep_purple"
        android:textColor="#FFFFFF" />
    <ImageButton
        android:id="@+id/delKbdButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/addpcbuttonrounded"
        android:backgroundTint="#AA4444"
        android:src="@android:drawable/ic_menu_delete"
        android:scaleType="centerInside"
        android:padding="8dp" />
</LinearLayout>
